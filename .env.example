# Battery Doctor – secrets. Copy to .env and then: chmod 600 .env
# Long-lived access token from Home Assistant (profile -> Security -> Long-lived access tokens).
HA_TOKEN=put-your-token-here

# Optional (Docker Compose only): backup target and user ID of the container
# AKD_BACKUP_DIR=/mnt/nas/backups/battery-doctor
# AKD_UID=1000
# AKD_GID=1000
